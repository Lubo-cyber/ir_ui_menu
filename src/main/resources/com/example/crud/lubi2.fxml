<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox spacing="20" styleClass="main-container" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crud.view.HelloController">
  <padding>
    <Insets top="30" right="30" bottom="30" left="30"/>
  </padding>
  <children>
    <HBox alignment="CENTER_LEFT" spacing="20">
      <Label text="Menú" styleClass="main-title"/>
      <Region HBox.hgrow="ALWAYS" />
      <TextField fx:id="textobuscar" promptText="Buscar por ID" styleClass="search-field"/>
      <Button fx:id="buscar" onAction="#botonbuscar" styleClass="icon-button">
        <graphic>
          <FontIcon iconLiteral="fas-search" iconSize="18"/>
        </graphic>
      </Button>
    </HBox>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="custom-table">
      <columns>
        <TableColumn fx:id="tablaid" prefWidth="100.0" text="ID" />
        <TableColumn fx:id="tablasecuencia" prefWidth="120.0" text="SEQUENCE" />
        <TableColumn fx:id="tablaactivo" prefWidth="100.0" text="ACTIVE" />
        <TableColumn fx:id="tablacreardate" prefWidth="150.0" text="CREATE_DATE" />
        <TableColumn fx:id="tablaname" prefWidth="150.0" text="NAME" />
      </columns>
    </TableView>
    <HBox spacing="15" alignment="CENTER_RIGHT">
      <Button fx:id="mas" onAction="#botonmas" styleClass="action-button, add-button">
        <graphic>
          <FontIcon iconLiteral="fas-plus" iconSize="18"/>
        </graphic>
      </Button>
      <Button fx:id="editar" onAction="#botoneditar" styleClass="action-button, edit-button">
        <graphic>
          <FontIcon iconLiteral="fas-edit" iconSize="18"/>
        </graphic>
      </Button>
      <Button fx:id="eliminar" onAction="#botoneliminar" styleClass="action-button, delete-button">
        <graphic>
          <FontIcon iconLiteral="fas-trash-alt" iconSize="18"/>
        </graphic>
      </Button>
      <Button fx:id="cargar" onAction="#botoncargar" styleClass="action-button, refresh-button">
        <graphic>
          <FontIcon iconLiteral="fas-sync-alt" iconSize="18"/>
        </graphic>
      </Button>
    </HBox>
  </children>
</VBox>