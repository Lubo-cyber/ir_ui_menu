<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="dialog-pane" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.crud.view.HelloController3" stylesheets="@Estilo.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <Label text="Nuevo elemento" styleClass="title" alignment="CENTER"/>
        <GridPane vgap="15" hgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
            </columnConstraints>
            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-medium"/>
            <TextField fx:id="idtext2" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Sequence:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-medium"/>
            <TextField fx:id="secuenciatext2" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Create_Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-medium"/>
            <DatePicker fx:id="datetext2" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Active:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-medium"/>
            <ChoiceBox fx:id="choicetext2" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Name:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label-medium"/>
            <TextField fx:id="nametext2" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox spacing="20" alignment="CENTER">
            <Button fx:id="botonaceptar2" onAction="#botonaceptaraction" text="Aceptar" styleClass="button-primary"/>
            <Button fx:id="botoncancelar2" onAction="#botoncancelaraction" text="Cancelar" styleClass="button-secondary"/>
        </HBox>
    </children>
</VBox>